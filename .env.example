# Alleen server-side gebruiken. Kopieer dit bestand naar .env.local.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Pas in een latere fase toe wanneer route- en geocodingfuncties worden geactiveerd.
GOOGLE_MAPS_API_KEY=
# Zet deze in Vercel én lokaal om ook afwijkende PDF-lay-outs door een AI te
# laten controleren. Zonder sleutel blijft de ingebouwde slimme documentlezer actief.
OPENAI_API_KEY=
OPENAI_IMPORT_MODEL=gpt-4.1-mini
